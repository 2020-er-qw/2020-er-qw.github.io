---
import { getText, type Lang } from '../i18n/helpers';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = getText(lang);
---
<footer class="site-footer">
  <div class="wrap">
    <div>{t.tagline}</div>
    <nav aria-label="Legal">
      <a href={`/${lang}/about/`}>{t.navAbout}</a>
      <a href={`/${lang}/privacy/`}>{t.privacyLink}</a>
      <a href={`/${lang}/cookies/`}>{t.cookiePolicyNav}</a>
      <a href={`/${lang}/subscribe/`}>{t.rssNav}</a>
    </nav>
    <div style="margin-top:12px">© {new Date().getFullYear()} AI Field Notes. {t.copyright}</div>
  </div>
</footer>
