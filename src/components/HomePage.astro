---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getText, parsePostId, type Lang } from '../i18n/helpers';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = getText(lang);
const isZh = lang === 'zh';

// 语言由文件名后缀决定：<名称>.md = 英文，<名称>.zh.md = 中文
const langPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .filter((p) => parsePostId(p.id).lang === lang)
  // 时间降序；同一毫秒时按 id 字母序兜底，保证顺序确定
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf() || (a.id < b.id ? -1 : 1));
const pinned = langPosts.find((p) => p.data.pinned);
const posts = langPosts.filter((p) => p.id !== pinned?.id);
const allTags = [...new Set(langPosts.flatMap((p) => p.data.tags))];
const fmt = (d) => d.toLocaleDateString(isZh ? 'zh-CN' : 'en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
---

<BaseLayout title={t.homeTitle} description={t.homeDesc} lang={lang}>
  <div class="page-hero">
    <h1 class="page-title">{t.homeH1}</h1>
    <p class="page-sub">{t.homeSub}</p>
  </div>

  <div class="layout-two-col">
    <main class="col-main">
      {pinned && (
        <a href={parsePostId(pinned.id).href} class="pinned-card">
          {pinned.data.cover && <img class="pinned-cover" src={pinned.data.cover} alt="" loading="eager" />}
          <div class="pinned-body">
            <span class="pinned-badge">📌 {t.pinnedLabel}</span>
            <h2>{pinned.data.title}</h2>
            <p class="post-excerpt">{pinned.data.description}</p>
            <div class="post-meta">{fmt(pinned.data.pubDate)}</div>
          </div>
        </a>
      )}

      {posts.length > 0 && <h2 class="section-label">{t.latestLabel}</h2>}
      {posts.length ? (
        <ul class="post-list">
          {posts.map((post) => (
            <li class="post-item">
              <a href={parsePostId(post.id).href} class="post-link">
                <div class="post-text">
                  <h2>{post.data.title}</h2>
                  <div class="post-meta">{fmt(post.data.pubDate)}</div>
                  <p class="post-excerpt">{post.data.description}</p>
                  <div class="tags">{post.data.tags.map((tag) => <span class="tag">{tag}</span>)}</div>
                </div>
                {post.data.cover && <img class="post-thumb" src={post.data.cover} alt="" loading="lazy" />}
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="page-sub">{t.noPosts}</p>
      )}
    </main>

    <aside class="col-side">
      <div class="side-card">
        <h3>{t.aboutCardTitle}</h3>
        <p>{t.aboutCardText}</p>
        <a href={`/${lang}/about/`} class="side-link">{t.moreAbout}</a>
      </div>
      <div class="side-card">
        <h3>{t.topics}</h3>
        <div class="tags">{allTags.map((tag) => <span class="tag">{tag}</span>)}</div>
      </div>
      <div class="side-card">
        <h3>{t.loopTitle}</h3>
        <p>{t.loopText}</p>
        <p><a href={`/${lang}/subscribe/`} class="side-link">RSS →</a></p>
      </div>
    </aside>
  </div>
</BaseLayout>
