---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getText, parsePostId, type Lang } from '../../i18n/helpers';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => {
    const info = parsePostId(post.id);
    // 互译稿：同名文件的另一种语言版本（已发布才生成切换链接）
    const siblingId = info.lang === 'en' ? info.zhId : info.enId;
    const sibling = posts.find((p) => p.id === siblingId);
    return {
      params: { slug: info.base + (info.lang === 'zh' ? '-zh' : '') },
      props: { post, translationHref: sibling ? parsePostId(sibling.id).href : undefined },
    };
  });
}

const { post, translationHref } = Astro.props;
const { Content } = await render(post);
const lang: Lang = parsePostId(post.id).lang;
const t = getText(lang);
const isZh = lang === 'zh';
const fmt = (d) => d.toLocaleDateString(isZh ? 'zh-CN' : 'en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  type="article"
  pubDate={post.data.pubDate}
  lang={lang}
  translationHref={translationHref}
  translationLang={isZh ? 'en' : 'zh'}
>
  <div class="reading">
  <article>
    <header class="post-header">
      {post.data.cover && <img class="post-cover" src={post.data.cover} alt="" />}
      <div class="post-meta">
        {fmt(post.data.pubDate)}{post.data.updatedDate ? ` · ${t.updated} ${fmt(post.data.updatedDate)}` : ''}
      </div>
      <h1 style="margin-top:10px">{post.data.title}</h1>
      <p class="lead">{post.data.description}</p>
      <div class="tags">{post.data.tags.map((tag) => <span class="tag">{tag}</span>)}</div>
    </header>

    <Content />

    <p class="disclaimer">{t.disclaimer}</p>
  </article>
  </div>
</BaseLayout>
