---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getText, type Lang } from '../../i18n/helpers';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const lang: Lang = post.data.lang === 'zh' ? 'zh' : 'en';
const t = getText(lang);
const isZh = lang === 'zh';
const fmt = (d) => d.toLocaleDateString(isZh ? 'zh-CN' : 'en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });

let translationHref;
let translationLang;
if (post.data.translation) {
  const all = await getCollection('blog', ({ data }) => !data.draft);
  const other = all.find((p) => p.id === post.data.translation);
  if (other) {
    translationHref = `/posts/${other.id}/`;
    translationLang = other.data.lang === 'zh' ? 'zh' : 'en';
  }
}
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  type="article"
  pubDate={post.data.pubDate}
  lang={lang}
  translationHref={translationHref}
  translationLang={translationLang}
>
  <div class="reading">
  <article>
    <header class="post-header">
      {post.data.cover && <img class="post-cover" src={post.data.cover} alt="" />}
      <div class="post-meta">
        {fmt(post.data.pubDate)}{post.data.updatedDate ? ` · ${t.updated} ${fmt(post.data.updatedDate)}` : ''}
      </div>
      <h1 style="margin-top:10px">{post.data.title}</h1>
      <p class="lead">{post.data.description}</p>
      <div class="tags">{post.data.tags.map((tag) => <span class="tag">{tag}</span>)}</div>
    </header>

    <Content />

    <p class="disclaimer">{t.disclaimer}</p>
  </article>
  </div>
</BaseLayout>
